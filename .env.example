# Copy this file to .env and fill in your values.

# Required - from discord.com/developers/applications > Bot > Token
DISCORD_TOKEN=your-bot-token-here

# Optional - unlocks the Google Safe Browsing secondary feed.
# Free key from developers.google.com/safe-browsing (non-commercial use).
GSB_API_KEY=

# Optional - SQLite database path (default: ./sentinel.db)
DB_PATH=./sentinel.db
